# ========================================================
# PayFlow — Payoneer Checkout Environment Configuration
# ========================================================

PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
MONGODB_URI=

PAYMENT_MODE=mock

PAYONEER_SANDBOX=true
PAYONEER_API_BASE_URL=https://api.sandbox.oscato.com/api/lists
PAYONEER_MERCHANT_CODE=YOUR_SANDBOX_MERCHANT_CODE
PAYONEER_API_TOKEN=YOUR_SANDBOX_API_TOKEN
PAYONEER_DIVISION=YOUR_SANDBOX_DIVISION_CODE

WEBHOOK_SECRET=payflow_default_webhook_secret_key
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=8h

OPERATIONS_ADMIN_EMAIL=ops@payflow.internal
OPERATIONS_ADMIN_PASSWORD=your_secure_operations_password
SANDBOX_ADMIN_EMAIL=sandbox@payflow.internal
SANDBOX_ADMIN_PASSWORD=your_secure_sandbox_admin_password
