PAYONEER_MERCHANT_CODE=YOUR_SANDBOX_MERCHANT_CODE
PAYONEER_API_TOKEN=YOUR_SANDBOX_API_TOKEN
PAYONEER_DIVISION=YOUR_SANDBOX_DIVISION_CODE

WEBHOOK_SECRET=payflow_default_webhook_secret_key
